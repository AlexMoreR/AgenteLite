// Suscripcion de Web Push (VAPID) de un dispositivo/navegador. Permite enviar
// notificaciones "tipo WhatsApp" (suenan/vibran con la PWA cerrada o en segundo
// plano) a cada colaborador del workspace cuando entra un mensaje. Se crea al
// aceptar el permiso de notificaciones y se elimina si el endpoint deja de ser
// valido (410/404 al enviar).
model WebPushSubscription {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

// Guion del Playbook de ventas, adentro del CRM. Objetivo: que la asesora no tenga que abrir el
// documento aparte — el chat le muestra que decir segun la etapa de ESE cliente, y el copiloto
// responde con estos mismos textos en vez de improvisar.
model PlaybookScript {
  id          String    @id @default(cuid())
  workspaceId String
  // "STAGE" = que decir en una etapa del embudo. "OBJECTION" = que contestar a una objecion.
  // Texto y no enum a proposito (mismo criterio que lostReason): agregar un tipo no deberia
  // obligar a migrar la base de produccion.
  kind        String
  // Etapa del CRM (valor de CrmStage) cuando kind = "STAGE"; null en las objeciones.
  stage       String?
  title       String
  // Texto listo para usar. El boton lo INSERTA en el compositor (no lo envia) para poder ajustarlo.
  content     String
  // Palabras con las que la asesora busca la objecion ("caro, precio, costoso").
  keywords    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, stage])
  @@index([workspaceId, sortOrder])
}

// Intento de llamada a un lead. Cada llamada es un EVENTO con historial (no un campo unico en
// Contact): guarda que paso y cuando volver a intentar. Alimenta la vista de la vendedora
// ("a quien llamo hoy y que paso la ultima vez") y el tablero del dueno. Reemplaza el Google
// Sheet temporal de registro de llamadas de Ingrid.
model CallAttempt {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  // Quien llamo (Ingrid/Alexander/Carlos). Opcional: puede quedar nulo en registros retroactivos.
  calledByUserId String?
  // Numero de intento por lead (1,2,3...). Se calcula al registrar (conteo previo + 1).
  attemptNumber  Int
  // Resultado de la llamada. Lista FIJA definida en crm-config (no enum ni texto libre): mismo
  // patron que Contact.lostReason, para poder medir sin migrar la BD de produccion al agregar uno.
  result         String
  // Resumen breve de lo que dijo el cliente (una linea).
  summary        String?
  // Cuando volver a intentar. Alimenta la priorizacion de la vista de la vendedora.
  nextContactAt  DateTime?
  // Obligatorio SOLO cuando result = "Cerrado - Perdido". Valores validos en crm-config.
  lostReason     String?
  // Fecha real de la llamada. EDITABLE (default now) para registrar llamadas retroactivas hechas
  // antes de lanzar el modulo (migracion del Google Sheet).
  calledAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  calledBy       User?     @relation("CallAttemptCaller", fields: [calledByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId, calledAt])
  @@index([workspaceId, calledAt])
  @@index([workspaceId, nextContactAt])
}

/// El playbook de ventas de UN producto: lo que la casa aprendio vendiendolo.
///
/// Vive aparte del embudo del diagrama del agente a proposito. El embudo dice el orden de los
/// pasos; el playbook dice COMO se vende: con que abrir, que no prometer nunca, y que contestar
/// a cada objecion. Es lo que se corrige cuando una venta se pierde, y por eso tiene que poder
/// cambiar todos los dias sin volver a publicar el agente.
model ProductPlaybook {
  id            String                @id @default(cuid())
  workspaceId   String
  productId     String
  /// A quien le sirve este producto y a quien no. Es lo primero que cambia el tono: no se le
  /// habla igual a la dueña de un spa que a quien pregunta de curiosidad.
  /// Palabras que, dichas por el cliente, identifican a este producto ("camilla", "combo").
  matchKeywords String[]              @default([])
  /// Titulos (o parte) de los anuncios que traen a este producto.
  matchAdTitles String[]              @default([])
  idealCustomer String?
  /// Que le duele a ese cliente. Es lo que se vende de verdad: nadie compra una camilla, compra
  /// dejar de perder clientas porque el local se ve improvisado.
  customerPain  String?
  /// Con que abrir y como llevar la conversacion de este producto.
  pitch         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  rules         ProductPlaybookRule[]
  stages        ProductFunnelStage[]

  @@unique([workspaceId, productId])
  @@index([workspaceId])
}

/// Cada cosa aprendida, por separado y con fecha.
///
/// Separadas y no un texto largo para que cada una se pueda apagar, ordenar y —sobre todo— para
/// saber CUANDO se agrego y de donde salio: si una regla nacio de una venta perdida, eso es lo
/// que convierte la auditoria en memoria en vez de en una reunion.
model ProductPlaybookRule {
  id                   String          @id @default(cuid())
  playbookId           String
  /// "DECIR" | "NO_DECIR" | "OBJECION". Texto y no enum: sumar un tipo no deberia obligar a
  /// migrar la base de produccion (mismo criterio que PlaybookScript.kind).
  kind                 String
  /// En las objeciones, lo que dice el cliente ("esta caro"). Null en las demas.
  trigger              String?
  text                 String
  sortOrder            Int             @default(0)
  isActive             Boolean         @default(true)
  /// "manual" | "auditoria". De donde salio la regla.
  source               String          @default("manual")
  /// El chat que la origino, cuando sale de revisar una venta perdida.
  originConversationId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  playbook             ProductPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, kind, sortOrder])
}

/// Una etapa del embudo de ventas del producto.
///
/// Son las cinco con las que ya trabaja el motor —presentacion, identificacion, producto, dudas
/// y cierre—, pero editables desde el producto y leidas AL RESPONDER. Antes solo se podian tocar
/// dentro del diagrama del agente y habia que republicar para que aplicaran.
model ProductFunnelStage {
  id                 String                 @id @default(cuid())
  playbookId         String
  /// PRESENTACION | IDENTIFICACION | PRODUCTO | OBJECIONES | CIERRE. Texto y no enum:
  /// si mañana una venta necesita otra etapa, no deberia obligar a migrar la base.
  stage              String
  /// Que hay que lograr en esta etapa antes de pasar a la siguiente.
  goal               String?
  /// Que decir para lograrlo.
  script             String?
  /// Red de seguridad: si el cliente lleva TANTOS mensajes sin salir de esta etapa, se avisa a un
  /// asesor. Null = sin red. Es el limite que no depende de lo que decida la IA.
  stuckAfterMessages Int?
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  playbook           ProductPlaybook        @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  /// Los "si no contesta" de esta etapa. Varios y no uno: un solo aviso es un recordatorio, y lo
  /// que recupera una venta es una secuencia (al dia, a los dos, a los tres).
  followUps          ProductStageFollowUp[]

  @@unique([playbookId, stage])
  @@index([playbookId, sortOrder])
}

/**
 * Un "si no contesta" de una etapa: cuanto esperar y que mandar.
 * Vive colgado de la ETAPA del producto y no de una FollowRule suelta porque el mensaje correcto
 * depende de donde se corto la charla: no es lo mismo que el cliente se calle en Presentacion
 * —ni sabemos que quiere— que en Cierre, donde ya sabe el precio y lo esta pensando. Una regla
 * por workspace no puede expresar esa diferencia.
 * Tabla propia (y no dos columnas en la etapa) porque son VARIOS por etapa: la secuencia de 1, 2
 * y 3 dias es lo que de verdad recupera un lead, no un unico aviso.
 */
model ProductStageFollowUp {
  id               String             @id @default(cuid())
  stageId          String
  sortOrder        Int                @default(0)
  /// Cuanto esperar desde que el lead entro a la etapa. Se cuenta desde la entrada y no desde el
  /// ultimo mensaje: es "hace tanto que esta en esta etapa sin avanzar".
  timeType         FollowTimeType     @default(DAYS)
  timeValue        Int
  messageType      FollowMessageType  @default(TEXT)
  content          String?
  mediaUrl         String?
  /// Si el cliente escribe antes, no sale. Es todo el sentido de "si no contesta".
  cancelOnActivity Boolean            @default(true)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  stage            ProductFunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, sortOrder])
}

/// Lo que paso en una conversacion, leido por la IA y guardado.
///
/// El CRM sabe quien escribio y cuando, pero no QUE pidio ni POR QUE se cayo. Eso vivia solo en el
/// texto del chat: para saberlo habia que abrirlo y leerlo entero, de a uno. Aca queda escrito una
/// vez y despues se puede contar, agrupar y mirar de a cientos.
model ConversationInsight {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String   @unique
  productId      String?
  /// Que pidio, en palabras del cliente.
  requested      String?
  /// "VIVO" | "MUERTO" | "GANADO". Texto y no enum: sumar un estado no deberia migrar la base.
  status         String
  /// En cual de las cinco etapas del embudo quedo.
  stage          String?
  /// Por que se cayo: precio, envio, no contesto, no lo vendemos, el bot no supo, otro.
  lostReason     String?
  /// Lo ultimo que le dijimos antes del silencio. Es la frase a corregir.
  lastOutbound   String?
  /// Una linea para leer sin abrir el chat.
  summary        String?
  /// Cuantos mensajes tenia la conversacion cuando se leyo: si crecio, hay que volver a leerla.
  messageCount   Int      @default(0)
  model          String?
  analyzedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, productId, status])
  @@index([workspaceId, lostReason])
}

/**
 * Una CAMPAÑA: elegir un grupo de leads hoy y mandarles un mensaje, una vez.
 * Es lo contrario de una FollowRule, y por eso vive aparte: la regla de seguimiento corre sola
 * para siempre sobre el que cumpla la condicion; la campaña se arma, se dispara y se termina.
 * Meterlas en el mismo modulo hacia que nadie supiera en cual entrar.
 * NO manda todo de una: WhatsApp bloquea numeros por mandar muchos mensajes parecidos a gente que
 * hace rato no escribe, y el numero que se cae es el que da de comer. Por eso la cantidad por
 * tanda y cada cuanto sale una tanda son campos obligatorios y no una opcion avanzada.
 */
model Campaign {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  /// Por que linea sale. Null = la primera disponible.
  channelId       String?
  /// La condicion del publico. Por ahora solo la etapa del CRM; se agregaran mas.
  crmStage        String?
  messageType     FollowMessageType   @default(TEXT)
  content         String?
  mediaUrl        String?
  /// Cuantos leads por tanda y cada cuantos minutos sale una tanda. El freno contra el bloqueo.
  batchSize       Int                 @default(20)
  intervalMinutes Int                 @default(30)
  status          CampaignStatus      @default(DRAFT)
  /// Cuantos entraron al publico cuando se inicio. La foto NO se recalcula: si se recalculara,
  /// un lead que cambia de etapa a mitad de campaña podria recibir el mensaje dos veces o
  /// quedarse sin recibirlo.
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  lastBatchAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         WhatsAppChannel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]

  @@index([workspaceId, status])
  @@index([status, lastBatchAt])
}

/// A quien le toca el mensaje de una campaña, y si ya salio. Es la foto del publico al iniciar.
model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  contactId  String
  status     CampaignRecipientStatus @default(PENDING)
  /// El envio que se creo para este lead. Se reusa el motor de seguimientos para mandar.
  followId   String?
  sentAt     DateTime?
  error      String?
  createdAt  DateTime                @default(now())
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  DONE
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

/**
 * BIBLIOTECA DE ARCHIVOS: los catalogos que se mandan todos los dias, subidos UNA vez.
 * El problema que resuelve no es de formato ni de permisos: es de tiempo. Las asesoras trabajan
 * desde el celular y con mala señal un catalogo de 15 MB tarda entre 8 y 18 minutos en subir —y
 * antes de terminar, la subida se corta—. Pero son SIEMPRE los mismos ocho archivos.
 * Subidos una vez desde una computadora, mandarlos deja de ser una subida y pasa a ser una
 * referencia a algo que ya esta en el servidor: sale en un segundo, con señal o sin ella.
 */
model MediaLibraryItem {
  id           String    @id @default(cuid())
  workspaceId  String
  /// Como lo busca una persona apurada: "Catalogo camillas", no el nombre del archivo.
  title        String
  /// Ruta ya publicada del archivo. Es la misma que usa el chat para mandar media.
  url          String
  fileName     String
  mimeType     String
  /// IMAGE | VIDEO | DOCUMENT, igual que en el chat.
  mediaType    String
  /// La tapa: primera pagina del PDF o miniatura del video, generada al agregarlo. Null = se
  /// muestra un icono. Sin esto los ocho catalogos se ven identicos en la grilla.
  thumbnailUrl String?
  sizeBytes    Int       @default(0)
  /// Cuantas veces se mando. Sirve para ordenar por lo mas usado en vez de por fecha.
  sentCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sentCount])
  @@index([workspaceId, createdAt])
}

/**
 * Un mapa mental. Lienzo en blanco para pensar el negocio.
 * El contenido (cajas, texto y conexiones) va entero en `data` como JSON y no en tablas aparte:
 * un diagrama se lee y se guarda SIEMPRE completo, nunca se consulta "todas las cajas que
 * digan X", y partirlo en dos tablas solo agregaria trabajo para volver a armarlo en cada
 * apertura.
 * Es PRIVADO de quien lo creo (`createdById`): se penso como herramienta personal, asi que las
 * consultas filtran por autor y no solo por workspace.
 */
model Diagram {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  title       String   @default("Sin titulo")
  /// Nodos y conexiones tal como los guarda el lienzo.
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("DiagramCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdById, updatedAt])
}

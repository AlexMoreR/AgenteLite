{
  "urlCrm": "https://app.aizenbot.com",
  "claveTrabajador": "aizen_trab_PEGAR_AQUI_LA_CLAVE_DEL_PANEL_TRABAJADOR",
  "carpetaTrabajo": "D:/Proyectos/trabajador-tablero-trabajo",
  "comandoClaude": ["claude"],
  "tiempos": {
    "intervaloSegundos": 60,
    "latidoSegundos": 60,
    "planMinutos": 19,
    "construirMinutos": 88,
    "subirMinutos": 29,
    "comandoMinutos": 30
  },
  "git": { "nombre": "Trabajador Tablero IA", "correo": "gestionmagilus@gmail.com" },
  "ssh": {
    "comando": ["ssh", "-o", "BatchMode=yes"],
    "destino": "USUARIO@SERVIDOR",
    "psql": "docker exec -i CONTENEDOR_POSTGRES psql -U postgres"
  },
  "repos": {
    "aizencrm": {
      "ruta": "D:/Proyectos/AgenteLite",
      "ramaBase": "main",
      "remoto": "origin",
      "instalar": ["npm", "ci"],
      "verificar": [
        ["npx", "prisma", "generate"],
        ["npx", "tsc", "--noEmit"],
        ["npm", "run", "build"]
      ],
      "pruebas": [
        ["npm", "run", "test:tableros"],
        ["npm", "run", "test:trabajador-tablero"]
      ],
      "lint": { "comando": ["npx", "eslint", "-f", "json", "."] },
      "carpetaMigraciones": "prisma/migrations",
      "ensayoPglite": ["npm", "run", "test:migraciones-pglite"],
      "ensayoProduccion": { "tablaGuia": "WhatsAppChannel" },
      "zonasProtegidas": {
        "BOT_VENTAS": [
          "src/lib/agent.ts",
          "src/lib/agent-*.ts",
          "src/lib/official-api-chatbot.ts",
          "src/lib/notas-internas-del-agente.ts",
          "src/features/agents-v2/**",
          "src/features/agent-actions/**",
          "src/features/flows/**"
        ],
        "LIBRO_V3": ["src/features/agente-v3/**", "src/lib/mcp/agente-v3.ts"],
        "META_ADS": [
          "src/features/ads-generator/**",
          "src/lib/ad-*.ts",
          "src/lib/ads-*.ts",
          "src/lib/origen-anuncio.ts",
          "src/features/campanas/**"
        ]
      },
      "subida": {
        "ciBuscar": ["gh", "run", "list", "--repo", "AlexMoreR/AgenteLite", "--commit", "{commit}", "--json", "databaseId", "--jq", ".[0].databaseId"],
        "ciEsperar": ["gh", "run", "watch", "{run}", "--repo", "AlexMoreR/AgenteLite", "--exit-status"],
        "ciMinutos": 20,
        "urlVersion": "https://app.aizenbot.com/api/version",
        "campoVersion": "version",
        "versionMinutos": 8,
        "urlArranque": "https://app.aizenbot.com/login"
      }
    },
    "gestion": {
      "ruta": "D:/Proyectos/Gestion",
      "ramaBase": "main",
      "remoto": "origin",
      "instalar": ["npm", "ci"],
      "verificar": [
        ["npx", "prisma", "generate"],
        ["npx", "tsc", "--noEmit"],
        ["npm", "run", "build"]
      ],
      "pruebas": [["npm", "test"]],
      "lint": { "comando": ["npx", "eslint", "-f", "json", "."] },
      "carpetaMigraciones": "prisma/migrations",
      "ensayoProduccion": { "tablaGuia": "SalePayment" },
      "zonasProtegidas": {},
      "subida": {
        "ciBuscar": ["gh", "run", "list", "--repo", "AlexMoreR/Gestion", "--commit", "{commit}", "--json", "databaseId", "--jq", ".[0].databaseId"],
        "ciEsperar": ["gh", "run", "watch", "{run}", "--repo", "AlexMoreR/Gestion", "--exit-status"],
        "ciMinutos": 20
      }
    }
  }
}
